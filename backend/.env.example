# Server Configuration
PORT=3000
NODE_ENV=development

# CORS - Allowed origins for cross-origin requests
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# MongoDB - Database connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT - Authentication tokens
JWT_SECRET=<your-jwt-secret>
JWT_REFRESH_SECRET=<your-jwt-refresh-secret>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Super Admin - Initial admin user seeded on first application boot
SUPER_ADMIN_EMAIL=<admin-email>
SUPER_ADMIN_PASSWORD=<admin-password>

# AWS S3 - Cloud storage for receipt uploads
AWS_BUCKET=<your-bucket-name>
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=<your-access-key>
AWS_SECRET_ACCESS_KEY=<your-secret-key>

# Redis - Cache and OTP storage
REDIS_URL=redis://<username>:<password>@<host>:<port>

# SMTP - Email service for OTPs and notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-email>
SMTP_PASS=<your-app-password>

# OTP Configuration - One-time password expiration time in seconds
OTP_EXPIRES_IN=300